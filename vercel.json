{
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "npm run build",
  "functions": {
    "api/image.js": { "maxDuration": 10 },
    "api/tse-registry.js": { "maxDuration": 30 },
    "api/tse-registry-v2.js": { "maxDuration": 30 },
    "api/sources.js": { "maxDuration": 15 },
    "api/election-results.js": { "maxDuration": 30 },
    "api/election-results-v2.js": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/election-results", "destination": "/api/election-results-v2" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key":"X-Content-Type-Options","value":"nosniff"},
        {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
        {"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"},
        {"key":"Cross-Origin-Opener-Policy","value":"same-origin"}
      ]
    }
  ]
}
